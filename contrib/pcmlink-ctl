#!/bin/sh
# pcmlink-ctl - start, stop, restart and inspect the audio link.
#
# A convenience wrapper for the common setup: a receiver on this machine and a
# sender on a host reachable over ssh. Written for macOS receivers; adjust the
# log path elsewhere.
#
#   receiver (this Mac)      pcmlink.py receive  ->  Focusrite
#   sender   (Linux host)    systemd --user unit "pcmlink-send", bound to the
#                            graphical session
#   sender   (Windows VM)    scheduled task "pcmlink-send"
#
# The Linux host and the Windows VM share one display, so at most one of them
# has a desktop session and only that one should send. The Linux host is asked
# first: if its graphical session is up, it is the sender and the VM is not
# queried, which also avoids waiting on ssh timeouts to a VM that is off.
#
# The receiver is deliberately started from your shell rather than by launchd:
# a launchd-spawned process is invisible to SoundSource, so its volume control
# would stop working. Keep it that way.

set -eu

DIR="${PCMLINK_DIR:-$HOME/projects/pcmlink}"
DEVICE="${PCMLINK_CTL_DEVICE:-Scarlett}"
VOLUME="${PCMLINK_CTL_VOLUME:-1.0}"
WIN="${PCMLINK_CTL_WIN_HOST:-win11}"
LINUX="${PCMLINK_CTL_LINUX_HOST:-pc}"
LOG="${PCMLINK_CTL_LOG:-$HOME/Library/Logs/pcmlink/receive.log}"
PY="${PCMLINK_CTL_PYTHON:-python3}"
TASK=pcmlink-send
UNIT=pcmlink-send.service

c_ok=$(printf '\033[32m'); c_bad=$(printf '\033[31m'); c_dim=$(printf '\033[2m'); c_off=$(printf '\033[0m')

rx_pid() { pgrep -f "pcmlink.py receive" 2>/dev/null | head -1; }
rx_count() { pgrep -f "pcmlink.py receive" 2>/dev/null | wc -l | tr -d ' '; }

rx_start() {
    if [ -n "$(rx_pid)" ]; then echo "receiver already running (pid $(rx_pid))"; return 0; fi
    mkdir -p "$(dirname "$LOG")"
    # Detach completely: stdin from /dev/null and both outputs to the log, so
    # the child holds none of this script's file descriptors open. Without that
    # a caller waiting on our output blocks until the receiver itself exits.
    ( cd "$DIR" && nohup "$PY" pcmlink.py receive --device "$DEVICE" --volume "$VOLUME" \
        </dev/null >>"$LOG" 2>&1 & ) >/dev/null 2>&1
    sleep 2
    if [ -n "$(rx_pid)" ]; then echo "receiver started (pid $(rx_pid))"
    else echo "${c_bad}receiver failed to start${c_off}; see $LOG"; return 1; fi
}

rx_stop() {
    pid=$(rx_pid) || true
    if [ -z "${pid:-}" ]; then echo "receiver not running"; return 0; fi
    pkill -f "pcmlink.py receive" 2>/dev/null || true
    sleep 1
    echo "receiver stopped (was pid $pid)"
}

# systemctl --user on the Linux host. Prints the unit state (active, inactive,
# failed, ...) or nothing when the host is unreachable.
linux_q() {
    ssh -o ConnectTimeout=8 -o BatchMode=yes "$LINUX" "systemctl --user is-active $1" \
        2>/dev/null | tail -1
}

# The Linux host owns the display when its graphical session is active.
linux_has_session() { [ "$(linux_q graphical-session.target)" = active ]; }

# Number of sender pipelines on the Windows VM. More than one means several
# RTP streams are arriving on the same port with independent sequence numbers,
# which the receiver scores as enormous packet loss. Ending the scheduled task
# does not kill processes it already started, so orphans accumulate silently.
win_count() {
    ssh -o ConnectTimeout=8 "$WIN" \
        'powershell -NoProfile -Command "(@(Get-Process gst-launch-1.0 -ErrorAction SilentlyContinue)).Count"' \
        2>/dev/null | tr -d '\r' | tail -1
}

tx_start() {
    if linux_has_session; then
        ssh -o ConnectTimeout=8 -o BatchMode=yes "$LINUX" "systemctl --user start $UNIT" \
            >/dev/null 2>&1 || { echo "${c_bad}could not start linux sender${c_off}"; return 1; }
        sleep 3
        if [ "$(linux_q "$UNIT")" = active ]; then echo "sender started (linux)"
        else echo "${c_bad}linux sender did not come up${c_off}"; return 1; fi
        return 0
    fi
    ssh -o ConnectTimeout=8 "$WIN" "schtasks /run /tn $TASK" >/dev/null 2>&1 || {
        echo "${c_bad}could not start sender${c_off}"; return 1; }
    sleep 6
    n=$(win_count)
    case "${n:-0}" in
        1) echo "sender started (windows)" ;;
        0) echo "${c_bad}sender did not come up${c_off}" ; return 1 ;;
        *) echo "${c_bad}warning: $n sender processes running${c_off}" ; return 1 ;;
    esac
}

tx_stop() {
    if linux_has_session; then
        ssh -o ConnectTimeout=8 -o BatchMode=yes "$LINUX" "systemctl --user stop $UNIT" \
            >/dev/null 2>&1 || true
        if [ "$(linux_q "$UNIT")" = active ]; then echo "${c_bad}linux sender still running${c_off}"
        else echo "sender stopped (linux)"; fi
        return 0
    fi
    ssh -o ConnectTimeout=8 "$WIN" "schtasks /end /tn $TASK" >/dev/null 2>&1 || true
    # Ending the task leaves its children behind; kill them explicitly.
    ssh -o ConnectTimeout=8 "$WIN" \
        'powershell -NoProfile -Command "Stop-Process -Name gst-launch-1.0,pythonw -Force -ErrorAction SilentlyContinue"' \
        >/dev/null 2>&1 || true
    sleep 2
    n=$(win_count)
    if [ "${n:-0}" = "0" ]; then echo "sender stopped (windows)"
    else echo "${c_bad}sender still has $n process(es)${c_off}"; fi
}

flow() {
    # Two samples a second apart: if the packet counter moves, audio is flowing.
    a=$(tail -1 "$LOG" 2>/dev/null)
    sleep 2
    b=$(tail -1 "$LOG" 2>/dev/null)
    [ -n "$a" ] && [ "$a" != "$b" ] || return 1
    # The line advances every second while running; require a non-zero rate too,
    # so "receiver alive but sender silent" is not reported as flowing.
    echo "$b" | grep -qE 'pkt/s= *[1-9]' || return 1
}

tx_status() {
    session=$(linux_q graphical-session.target)
    if [ "$session" = active ]; then
        case "$(linux_q "$UNIT")" in
            active) printf '%srunning%s  linux (%s)\n' "$c_ok" "$c_off" "$LINUX" ;;
            *)      printf '%sstopped%s  linux (%s) has the desktop session\n' "$c_bad" "$c_off" "$LINUX" ;;
        esac
        return 0
    fi
    if [ -z "$session" ]; then
        printf '%slinux unreachable%s (%s), ' "$c_dim" "$c_off" "$LINUX"
    fi
    n=$(win_count)
    case "${n:-}" in
        1)  printf '%srunning%s  windows (%s)\n' "$c_ok" "$c_off" "$WIN" ;;
        0)  printf '%sstopped%s  windows (%s)\n' "$c_bad" "$c_off" "$WIN" ;;
        "") printf '%sunreachable%s (%s)\n' "$c_bad" "$c_off" "$WIN" ;;
        *)  printf '%s%s processes on windows - duplicates cause false packet loss%s\n' \
                "$c_bad" "$n" "$c_off" ;;
    esac
}

status() {
    printf 'receiver  '
    pid=$(rx_pid) || true
    if [ -n "${pid:-}" ]; then printf '%srunning%s  pid %s\n' "$c_ok" "$c_off" "$pid"
    else printf '%sstopped%s\n' "$c_bad" "$c_off"; fi

    if [ "$(rx_count)" -gt 1 ]; then
        printf '          %swarning: %s receiver processes%s\n' "$c_bad" "$(rx_count)" "$c_off"
    fi

    printf 'sender    '
    tx_status

    printf 'audio     '
    if [ -n "${pid:-}" ] && flow; then printf '%sflowing%s\n' "$c_ok" "$c_off"
    else printf '%sno packets%s\n' "$c_bad" "$c_off"; fi

    printf 'loss      '
    la=$(tail -1 "$LOG" 2>/dev/null | grep -oE 'lost=[0-9]+' | cut -d= -f2)
    sleep 2
    lb=$(tail -1 "$LOG" 2>/dev/null | grep -oE 'lost=[0-9]+' | cut -d= -f2)
    if [ -z "${la:-}" ]; then printf '%sunknown%s\n' "$c_dim" "$c_off"
    elif [ "$la" = "$lb" ]; then
        printf '%sstable%s (%s cumulative, not increasing)\n' "$c_ok" "$c_off" "$la"
    else
        printf '%sincreasing%s (+%s in 2s)\n' "$c_bad" "$c_off" "$((lb - la))"
    fi

    printf '%s%s%s\n' "$c_dim" "$(tail -1 "$LOG" 2>/dev/null)" "$c_off"
}

sender_logs() {
    if linux_has_session; then
        ssh -t "$LINUX" "journalctl --user -u $UNIT -n 30 -f"
    else
        ssh "$WIN" 'powershell -NoProfile -c "Get-Content \"$env:LOCALAPPDATA\pcmlink\send.log\" -Tail 30 -Wait"'
    fi
}

case "${1:-status}" in
    status)   status ;;
    start)    rx_start; tx_start ;;
    stop)     tx_stop; rx_stop ;;
    restart)  tx_stop; rx_stop; sleep 1; rx_start; tx_start; sleep 3; echo; status ;;
    restart-rx|rx) rx_stop; sleep 1; rx_start ;;
    restart-tx|tx) tx_stop; sleep 1; tx_start ;;
    logs)     tail -f "$LOG" ;;
    sender-logs) sender_logs ;;
    *) cat <<USAGE
usage: pcmlink-ctl [command]

  status        both ends, and whether packets are actually moving (default)
  start|stop    both ends
  restart       both ends, then show status
  restart-rx    receiver only (this Mac)
  restart-tx    sender only (Linux host if it has the desktop session, else Windows VM)
  logs          follow the receiver log
  sender-logs   follow the active sender's log over ssh

environment:
  PCMLINK_CTL_DEVICE      output device substring             (default: Scarlett)
  PCMLINK_CTL_VOLUME      software gain                       (default: 1.0)
  PCMLINK_CTL_LINUX_HOST  ssh host alias of the Linux sender  (default: pc)
  PCMLINK_CTL_WIN_HOST    ssh host alias of the Windows VM    (default: win11)
  PCMLINK_CTL_LOG         receiver log path
  PCMLINK_CTL_PYTHON      interpreter to run the receiver     (default: python3)
  PCMLINK_DIR             checkout containing pcmlink.py
USAGE
       exit 1 ;;
esac
